# Copy this file to .env.local for local development. Never commit real values.

# --- Website (Next.js / Vercel) ---------------------------------------------
# Your Convex deployment's URL, e.g. https://happy-animal-123.convex.cloud
# (shown in the Convex dashboard under Settings -> URL & Deploy Key).
NEXT_PUBLIC_CONVEX_URL=

# Used by `npx convex dev` / `npx convex deploy`. Filled in automatically by
# `npx convex dev`. For deploying from Vercel, use CONVEX_DEPLOY_KEY instead.
CONVEX_DEPLOYMENT=
# CONVEX_DEPLOY_KEY=

# --- Set on the Convex deployment (dashboard -> Settings -> Environment
# Variables, or `npx convex env set NAME value`), NOT in this file ----------
# SITE_URL                  The website address, e.g. http://localhost:3000 or https://mealsync.vercel.app
# JWT_PRIVATE_KEY, JWKS     Login signing keys. Generate with: npx @convex-dev/auth
# MEALSYNC_ALLOW_DEV_SEED   "true" ONLY on a development deployment, to allow test data
# DEV_SEED_PASSWORD         Password given to the TEST accounts (development only)
